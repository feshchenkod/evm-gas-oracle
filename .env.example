# Optional: the same values can be set directly in docker-compose.yml.
ETHEREUM_URL=http://host.docker.internal:8545
POLLING_FREQUENCY_SECONDS=5
# Use ignore for BSC positive-fee sampling; skip-block preserves sampling semantics.
ZERO_GAS_PRICE_POLICY=skip-block
PORT=8080
RPC_MAX_REQUESTS_PER_SECOND=5
RPC_TIMEOUT=10s
# Empty uses max(2m, 3 x POLLING_FREQUENCY_SECONDS).
STALE_AFTER=
RPC_MAX_RESPONSE_BYTES=33554432
# Increase both budgets together when increasing RPC_MAX_RESPONSE_BYTES.
GOMEMLIMIT=192MiB
MEMORY_LIMIT=256m
BIND_ADDR=127.0.0.1
# Binary/custom deployment only; changing the internal port also needs port mapping changes.
# HTTP_ADDR=:80
